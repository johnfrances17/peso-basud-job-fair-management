{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api(/.*)?$", "dest": "/api/index", "check": true },
    { "src": "/((?!api/).*)", "dest": "/index.html", "check": true }
  ]
}
