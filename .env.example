# PostgreSQL / Supabase connection. For Supabase use the pooled connection
# string from Project Settings -> Database, e.g.:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/basud_db
# Set to true for remote managed Postgres (Supabase) connections
DATABASE_SSL=false

# HTTP server
PORT=3001

# Staff session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tokens signed without this are rejected; changing it invalidates sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Tests only. When unset, tests reuse DATABASE_URL and isolate data in the
# `test` schema, so a dedicated test database is optional.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/basud_db
