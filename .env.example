# PostgreSQL / Supabase connection. Use the pooled connection string from
# Supabase Project Settings -> Database (port 6543), e.g.:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Required for remote managed Postgres (Supabase). Set to false only when
# running against a bare local Postgres during development.
DATABASE_SSL=true

# HTTP server
PORT=3001

# Staff session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST also be set in the Vercel project settings — without it, sessions die
# on every cold start and staff get logged out.
AUTH_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API directly. Same-origin
# calls (Vite dev proxy, Vercel /api/* on the same domain) need no CORS config.
# Only needed if another app calls this API cross-origin. Entries like
# https://*.vercel.app match any Vercel preview subdomain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Tests only. When unset, tests reuse DATABASE_URL and isolate all data in a
# dedicated `test` schema (safe even on the shared Supabase project — public
# data is untouched). GitHub Actions reads this from the TEST_DATABASE_URL
# repository secret.
# TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
